<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Josh Urban Davis</title>
<style>
html,body{margin:0;width:100%;height:100%;background:#050505;overflow-x:hidden}
body{font-family:system-ui,sans-serif}
#josh{position:fixed;inset:0;width:100%;height:100%;border:0;z-index:1;background:#050505}
#veil{position:fixed;inset:0;z-index:3;pointer-events:none;overflow:hidden}
#jam{position:absolute;left:50%;top:0;width:500px;height:1100px;border:0;transform:translateX(-50%);background:#000;opacity:0}
#noise{position:absolute;inset:0;opacity:0;mix-blend-mode:screen;background-image:url('1996/img/bg_stars.gif');background-size:220px 220px;pointer-events:none}
#fragments{position:absolute;inset:0;pointer-events:none}
.frag{position:absolute;image-rendering:auto;opacity:0;filter:none;transition:none}
#status{position:fixed;right:14px;bottom:12px;z-index:10;color:rgba(255,255,255,.18);font:10px/1 monospace;letter-spacing:.12em;opacity:0;pointer-events:none}
body.debug #status{opacity:1}
</style>
</head>
<body>
<iframe id="josh" src="josh-site.html" title="Josh Urban Davis"></iframe>
<div id="veil">
  <div id="noise"></div>
  <div id="fragments"></div>
  <iframe id="jam" src="1996/index.html" title="Space Jam 1996"></iframe>
</div>
<div id="status"></div>

<script>
(function(){
'use strict';
const TOTAL=365;
const KEY='dwt_palimpsest_refresh_v2';
const params=new URLSearchParams(location.search);
if(params.has('reset')) localStorage.removeItem(KEY);
let step=Number(localStorage.getItem(KEY)||0);
if(!Number.isFinite(step)) step=0;
step=Math.min(step+1,TOTAL);
localStorage.setItem(KEY,String(step));
if(params.has('debug')) document.body.classList.add('debug');
document.getElementById('status').textContent='TRANSFORMATION '+String(step).padStart(3,'0')+' / '+TOTAL;

const fragments=[
 ['p-jamlogo.gif','jamlogo',50,205,272,165],
 ['p-pressbox.gif','pressbox',15,180,131,56],
 ['p-jamcentral.gif','central',46,178,55,67],
 ['p-bball.gif','bball',59,178,62,62],
 ['p-lunartunes.gif','tunes',76,205,95,77],
 ['p-lineup.gif','lineup',17,290,63,52],
 ['p-jump.gif','jump',77,290,58,52],
 ['p-junior.gif','junior',17,360,49,57],
 ['p-studiostore.gif','store',78,365,94,72],
 ['p-souvenirs.gif','souvenirs',30,445,83,83],
 ['p-sitemap.gif','sitemap',51,465,104,67],
 ['p-behind.gif','behind',70,430,67,63]
];

function addFragment(item){
 const [file,cls,x,y,w,h]=item;
 const im=document.createElement('img');
 im.className='frag '+cls;
 im.src='1996/img/'+file;
 im.width=w; im.height=h;
 // Coordinates are relative to the original 500px Space Jam canvas.
 im.style.left='calc(50% + '+(x-250)+'px)';
 im.style.top=y+'px';
 document.getElementById('fragments').appendChild(im);
 return im;
}
const ims=fragments.map(addFragment);

function clamp01(x){return Math.max(0,Math.min(1,x))}
function ease(x){x=clamp01(x);return x*x*(3-2*x)}
function stage(a,b){return ease((step-a)/(b-a))}

// 1–70: contamination. Almost imperceptible at first.
const n=stage(1,70);
document.getElementById('noise').style.opacity=(0.01+0.18*n).toFixed(3);
document.getElementById('josh').style.filter=`saturate(${1-0.18*n}) contrast(${1+0.06*n})`;
document.getElementById('josh').style.opacity=1-0.05*n;

// Tiny fragments begin appearing, one at a time.
const fragmentProgress=stage(38,235);
ims.forEach((im,i)=>{
  const p=clamp01(fragmentProgress*fragments.length-i);
  im.style.opacity=(p<=0?0:Math.min(1,p));
  im.style.transform='translate(-50%,0) scale('+(0.96+0.04*ease(p))+')';
});

// 70–160: the old page starts losing its visual language.
const language=stage(70,160);
document.getElementById('josh').style.filter=
 `grayscale(${0.55*language}) saturate(${1-0.65*language}) contrast(${1+0.22*language})`;
document.getElementById('josh').style.opacity=1-0.28*language;

// 130–250: Space Jam's starfield becomes the environment.
const stars=stage(120,250);
document.getElementById('noise').style.opacity=(0.10+0.78*stars).toFixed(3);
document.getElementById('noise').style.backgroundSize=(220-70*stars)+'px '+(220-70*stars)+'px';

// 175–290: the actual 1996 page begins replacing the hybrid.
const takeover=stage(175,315);
const jam=document.getElementById('jam');
jam.style.opacity=takeover;
const reveal=takeover*100;
jam.style.clipPath='inset(0 0 '+(100-reveal)+'% 0)';

// The original page recedes as the artifact takes over.
document.getElementById('josh').style.opacity=Math.max(0,1-0.72*takeover);

// 280–350: collapse the remaining modern page.
if(step>=280){
  const collapse=stage(280,350);
  document.getElementById('josh').style.opacity=Math.max(0,0.28*(1-collapse));
  document.getElementById('noise').style.opacity=(0.82+0.18*collapse).toFixed(3);
  ims.forEach(im=>im.style.opacity=Math.max(Number(im.style.opacity||0),0.95*collapse));
}

// 315+: exact local copy is all that remains.
if(step>=315){
  jam.style.opacity=1;
  jam.style.clipPath='none';
  document.getElementById('josh').style.display='none';
  document.getElementById('noise').style.opacity=0;
  document.getElementById('fragments').style.display='none';
}

// At the terminal state, let the local copy occupy the page cleanly.
if(step>=TOTAL){
  jam.style.position='fixed';
  jam.style.left='50%';
  jam.style.top='0';
  jam.style.transform='translateX(-50%)';
  jam.style.width='500px';
  jam.style.height='100vh';
}

// Clicking while holding Alt resets; useful during installation/testing.
window.addEventListener('keydown',e=>{
 if(e.altKey && e.key.toLowerCase()==='r'){
   localStorage.removeItem(KEY); location.reload();
 }
});
})();
</script>
</body>
</html>
